# Wahaj Arabic Annotation Engine Configuration

# Groq API Configuration for Intelligent LLM NER Layer (llama-3.3-70b-versatile)
# Get your free key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=12.0

# Local BERT Model for Named Entity Recognition
LOCAL_NER_MODEL=hatmimoha/arabic-ner
ENABLE_LOCAL_NER=true

# Database Connection (Default: Local SQLite)
# For PostgreSQL: postgresql://user:password@localhost:5432/wahaj_db
DATABASE_URL=sqlite:///./annotations.db

# CAMeL Tools Configuration (Optional local directory path for datasets)
ENABLE_CAMEL_TOOLS=true
CAMEL_DATA_DIR=
